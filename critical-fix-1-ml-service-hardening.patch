 # ── App setup ─────────────────────────────────────────────────────────────────
 
 app = Flask(__name__)
-CORS(app)
+
+# This service is internal-only — the Node backend is its sole caller
+# (see backend/services/mlBridgeService.js), never a browser directly.
+# CORS is restricted to ML_ALLOWED_ORIGIN (defaults to the Node backend's
