# ============================================================
# AI LEARNING PLATFORM — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values
# ============================================================

# ---- SERVER ----
NODE_ENV=development
PORT=5000

# ---- MONGODB ----
MONGO_URI=mongodb://localhost:27017/ai_learning_platform
# OR MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/ai_learning_platform

# ---- JWT ----
JWT_SECRET=change_this_to_a_32_plus_char_random_secret
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# ---- CORS ----
CLIENT_URL=http://localhost:3000

# ---- AI / GROQ API ----
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ---- PYTHON AI ENGINE ----
AI_SERVICE_URL=http://localhost:8000

# ---- FILE UPLOAD ----
MAX_FILE_SIZE=10485760
FILE_UPLOAD_PATH=./uploads

# ---- RATE LIMITING ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
RATE_LIMIT_AUTH_MAX=20

ML_SERVICE_URL=http://localhost:5001

# Shared secret the Node backend sends on every call to the Flask ML
# service (backend/ml_service/app.py reads the same var). Set this to
# a random string before deploying — without it, /ml/train and student
# data endpoints on the ML service are unauthenticated.
ML_SECRET=

# CORS origin the Flask ML service accepts (set on the ML service's own
# environment, not here — listed for reference). Defaults to
# http://localhost:5000, i.e. this Node backend.
# ML_ALLOWED_ORIGIN=http://localhost:5000

# ---- EMAIL (Nodemailer) ----
# Leave SMTP_HOST blank → Ethereal test account used automatically (dev only).
# Preview links are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AI Learning Platform <no-reply@ai-learning.dev>